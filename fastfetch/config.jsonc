{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "cyan",
    },
    "padding": {
      "right": 3
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "outputColor": "#C78B60"
    },
    {
      "type": "separator"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "8"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "8"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "8"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "8"
    },
    {
      "type": "separator"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "8"
    }
  ]
}
